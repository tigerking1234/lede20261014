CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y
CONFIG_TARGET_ARCH_PACKAGES=x86_64

# 核心系统 & 限速内核依赖（NFTRL、tc流量控制必备）
CONFIG_LIBCURL_OPENSSL=y
CONFIG_OPENSSL_WITH_TLS13=y
CONFIG_PACKAGE_base-files=y
CONFIG_PACKAGE_busybox=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_kmod-nft-core=y
CONFIG_PACKAGE_kmod-nft-tables=y
CONFIG_PACKAGE_kmod-nft-queue=y
CONFIG_PACKAGE_kmod-ifb=y
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-sched-tc=y
CONFIG_PACKAGE_tc=y

# LuCI基础界面 + 主题 + 中文
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-lib-ip=y
CONFIG_PACKAGE_luci-lib-jsonc=y
CONFIG_PACKAGE_luci-lib-nixio=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y

# NFTRL 局域网设备一键限速（你的核心需求）
CONFIG_PACKAGE_luci-app-nftrl=y
CONFIG_PACKAGE_nftrl=y

# Passwall 代理
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-app-passwall_Iptables_Transparent_Proxy=y
CONFIG_PACKAGE_luci-app-passwall_Nftables_Transparent_Proxy=y
CONFIG_PACKAGE_luci-i18n-passwall-zh-cn=y

# PVE 虚拟网卡/磁盘驱动
CONFIG_PACKAGE_kmod-virtio-net=y
CONFIG_PACKAGE_kmod-virtio-blk=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_iptables-nft=y

# 常用基础工具
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget=y
CONFIG_PACKAGE_openssl-util=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_ncat=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_screen=y
CONFIG_PACKAGE_vim-full=y
CONFIG_PACKAGE_rsync=y

# DDNS 动态域名解析
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_ddns-scripts_aliyun=y
CONFIG_PACKAGE_ddns-scripts_dnspod=y

# AdGuardHome 广告+DNS过滤
CONFIG_PACKAGE_luci-app-adguardhome=y
CONFIG_PACKAGE_adguardhome=y

# 硬盘挂载、NTFS/EXT4文件系统
CONFIG_PACKAGE_luci-app-mountd=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_ntfs3-mount=y

# 网络流量统计 & 监控
CONFIG_PACKAGE_luci-app-statistics=y
CONFIG_PACKAGE_collectd=y
CONFIG_PACKAGE_luci-app-netdata=y
CONFIG_PACKAGE_luci-app-nlbwmon=y

# 网络唤醒 WOL
CONFIG_PACKAGE_luci-app-wol=y

# 端口转发
CONFIG_PACKAGE_luci-app-forwarding=y

# 定时重启
CONFIG_PACKAGE_luci-app-autoreboot=y

# 多线负载 / 带宽叠加（mwan3）
CONFIG_PACKAGE_luci-app-mwan3=y
CONFIG_PACKAGE_mwan3=y

# 访客网络
CONFIG_PACKAGE_luci-app-guest-wifi=y

# 快捷重启网络
CONFIG_PACKAGE_luci-app-reloadfirewall=y

# 系统信息面板
CONFIG_PACKAGE_luci-app-system=y

# 在线升级
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_upnp=y

# 网络诊断工具
CONFIG_PACKAGE_luci-app-diag-core=y
CONFIG_PACKAGE_traceroute=y
CONFIG_PACKAGE_mtr=y

# IPv6支持
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_luci-proto-ipv6=y
